# ─────────────────────────────────────────────────────────────
#  Glasspot Lab — configuración privada
#  1. Copiá este archivo y renombrá la copia a:  .env.local
#  2. Pegá tu clave de OpenAI después del signo =
#  3. Guardá y reiniciá la web ("Iniciar Glasspot Lab")
#  .env.local NUNCA se comparte, ni se manda por chat, ni se sube a internet.
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=

# Modo prueba: sin límites por visitante y con datos técnicos para la comparación.
# Dejarlo en "si" solo en tu PC. En la web publicada se borra esta línea.
MODO_PRUEBA=si

# ── Opcionales (si no se completan se usan estos valores) ──
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high
# OPENAI_VISION_MODEL=gpt-5.4-mini
# CONTROL_CALIDAD=si                 # "no" para desactivar el control automático
# LIMITE_POR_IP_HORA=6
# LIMITE_DIARIO=40

# Google (Nano Banana) — se agrega en el próximo paso
# GEMINI_API_KEY=
